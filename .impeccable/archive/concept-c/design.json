  "components": [
    {
      "name": "Dark Action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Square plum action on a light field.",
      "html": "<button class=\"ds-button-dark\">Обсудить задачу<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 12h15m-6-6 6 6-6 6\" stroke=\"currentColor\" stroke-width=\"1.6\"/></svg></button>",
      "css": ".ds-button-dark{font-family:Montserrat,sans-serif;display:inline-flex;align-items:center;justify-content:space-between;gap:18px;background:var(--plum,#280839);color:var(--paper,#f4f4f6);border:0;border-radius:0;padding:1.3vw 2.65vw;font-size:1.43vw;font-weight:500;cursor:pointer}.ds-button-dark:hover{background:var(--violet,#491a77)}.ds-button-dark:focus-visible{outline:3px solid var(--violet,#491a77);outline-offset:5px;}"
    },
    {
      "name": "Light Action",
      "kind": "button",
      "refersTo": "button-light",
      "description": "Paper action used in the dark discussion section.",
      "html": "<button class=\"ds-button-light\">Подготовить обращение<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 12h15m-6-6 6 6-6 6\" stroke=\"currentColor\" stroke-width=\"1.6\"/></svg></button>",
      "css": ".ds-button-light{font-family:Montserrat,sans-serif;display:inline-flex;align-items:center;justify-content:space-between;gap:18px;background:var(--paper,#f4f4f6);color:var(--plum,#280839);border:0;border-radius:0;padding:22px 26px;font-size:18px;font-weight:500;cursor:pointer}.ds-button-light:hover{background:#ded3ed}.ds-button-light:focus-visible{outline:3px solid var(--paper,#f4f4f6);outline-offset:5px}"
    },
    {
      "name": "Task Textarea",
      "kind": "input",
      "refersTo": "input-task",
      "description": "Resizable local task field with a visible label and hint.",
      "html": "<div class=\"ds-task\"><label for=\"ds-task-field\">Кратко опишите задачу</label><textarea id=\"ds-task-field\" aria-describedby=\"ds-task-hint\" placeholder=\"Что хотите изменить в продажах?\"></textarea><p id=\"ds-task-hint\">Прототип: текст остаётся только на этой странице.</p></div>",
      "css": ".ds-task{font-family:Montserrat,sans-serif;background:var(--plum,#280839);color:var(--paper,#f4f4f6);padding:24px}.ds-task label{display:block;font-size:20px;margin-bottom:18px}.ds-task textarea{font-family:Montserrat,sans-serif;display:block;width:100%;min-height:160px;resize:vertical;border:1px solid #ab8ec4;border-radius:0;padding:20px;background:#351447;color:var(--paper,#f4f4f6);font-size:17px;line-height:1.55;caret-color:#e3c4fa}.ds-task textarea::placeholder{color:#d0badf}.ds-task textarea:focus-visible{outline:3px solid var(--paper,#f4f4f6);outline-offset:5px}.ds-task p{font-size:13px;line-height:1.55;color:#d7c2e6}"
    },
    {
      "name": "Readiness Label",
      "kind": "chip",
      "refersTo": "status-ready",
      "description": "Noninteractive operating-state pill; text carries the state.",
      "html": "<span class=\"ds-ready\">Работает</span>",
      "css": ".ds-ready{font-family:Montserrat,sans-serif;display:table;border-radius:30px;font-size:1.1vw;line-height:1.5;font-weight:600;padding:.5vw 1.7vw;background:#97c89d;color:#112d2b}@media(max-width:900px){.ds-ready{font-size:12px;padding:6px 14px}}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "description": "Plain links on plum, underlined on hover.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Основная\"><a href=\"#products\">Продукты</a><button type=\"button\">Обсудить задачу</button></nav>",
      "css": ".ds-nav{font-family:Montserrat,sans-serif;display:flex;gap:3.1vw;background:var(--plum,#280839);color:var(--paper,#f4f4f6);padding:20px;font-size:1.28vw;letter-spacing:-.04em}.ds-nav a,.ds-nav button{color:inherit;font:inherit;text-decoration:none}.ds-nav button{border:0;padding:0;background:transparent;cursor:pointer}.ds-nav a:hover,.ds-nav button:hover{text-decoration:underline;text-underline-offset:7px}.ds-nav a:focus-visible,.ds-nav button:focus-visible{outline:3px solid var(--paper,#f4f4f6);outline-offset:5px}@media(max-width:900px){.ds-nav{font-size:14px;gap:24px}}"
    },
    {
      "name": "Demonstration Panel",
      "kind": "card",
      "refersTo": "demo-panel",
      "description": "Flat product-color scenario panel with a textual disclosure.",
      "html": "<section class=\"ds-demo\"><h3>От сигнала к контакту</h3><p class=\"ds-demo-note\">Условный пример · не данные клиента</p><p class=\"ds-demo-signal\">Компания интересуется предложениями в вашей категории.</p><button type=\"button\">Что делает менеджер дальше?</button></section>",
      "css": ".ds-demo{font-family:Montserrat,sans-serif;background:var(--violet,#491a77);color:var(--paper,#f4f4f6);padding:40px}.ds-demo h3{margin:0;font-size:24px;letter-spacing:-.03em;line-height:1.2}.ds-demo-note{font-size:13px;line-height:1.55;color:#e1d3ee;margin:12px 0 34px}.ds-demo-signal{font-size:22px;font-weight:600;line-height:1.4}.ds-demo button{font-family:Montserrat,sans-serif;display:block;width:100%;border:0;border-top:1px solid #bda2d2;padding:20px 0 0;margin-top:32px;background:transparent;color:inherit;text-align:left;font-size:16px;cursor:pointer}.ds-demo button:hover{text-decoration:underline;text-underline-offset:6px}.ds-demo button:focus-visible{outline:3px solid var(--paper,#f4f4f6);outline-offset:5px}@media(max-width:900px){.ds-demo{padding:28px 24px}.ds-demo-signal{font-size:20px}}"
    },
    {
      "name": "Product Index Tile",
      "kind": "custom",
      "description": "Native product selector; flat geometric R, name and pilot readiness.",
      "html": "<button type=\"button\" class=\"ds-product\" aria-pressed=\"false\"><span class=\"ds-r\" aria-hidden=\"true\"><i></i><b></b></span><span class=\"ds-product-name\">NeuroROP</span><span class=\"ds-pilot\">Пилот</span></button>",
      "css": ".ds-product{font-family:Montserrat,sans-serif;position:relative;overflow:hidden;border:0;text-align:left;padding:185px 20px 20px;width:320px;height:290px;background:var(--ink,#171718);color:var(--paper,#f4f4f6);cursor:pointer}.ds-product-name{position:relative;display:block;font-size:18px;font-weight:700;letter-spacing:-.04em;line-height:1.15}.ds-pilot{position:relative;display:table;border-radius:30px;font-size:12px;line-height:1.5;font-weight:600;padding:6px 14px;margin-top:12px;background:#b8a886;color:#201b11}.ds-product:hover .ds-product-name{text-decoration:underline;text-underline-offset:7px}.ds-product:focus-visible{outline:3px solid var(--paper,#f4f4f6);outline-offset:-6px}.ds-product[aria-pressed=\"true\"]{outline:3px solid var(--paper,#f4f4f6);outline-offset:-8px}.ds-r{position:absolute;display:block;left:12px;top:24px;width:100%;height:160px;pointer-events:none}.ds-r i{position:absolute;left:0;top:0;width:calc(100% - 12px);height:85px;background:var(--paper,#f4f4f6);border-radius:0 80px 80px 0;clip-path:polygon(0 0,100% 0,100% 100%,70% 100%,23% 76%,0 76%)}.ds-r i::after{content:\"\";position:absolute;top:36px;left:0;width:75%;height:29px;border-radius:0 28px 28px 0;background:var(--ink,#171718)}.ds-r b{position:absolute;left:25px;top:63px;width:80%;height:73px;background:var(--paper,#f4f4f6);clip-path:polygon(0 0,53% 0,100% 100%,62% 100%)}"
    }
  ],
  "narrative": {
    "northStar": "AI Agency — typographic index",
    "overview": "The approved C world uses dense Montserrat lettering, large uninterrupted color fields and sharply cut geometric letterforms. The visual tone is assertive and editorial; information is organized by type, space and color rather than floating boxes.\n\nThe current identity is LeadGenBureau. Russian copy and honest readiness labels remain legible parts of the composition. The visual system does not imply a unified production platform or verified commercial results.",
    "keyCharacteristics": [
      "Flat plum, violet, cobalt and paper fields.",
      "Dense grotesque typography with tightly tracked headings.",
      "Square controls and containers; rounded readiness labels.",
      "A continuous geometric product index with readable text beneath its artwork."
    ],
    "rules": [
      {
        "name": "The Field Identity Rule",
        "body": "Keep product-field colors paired with their demonstration panels; do not make readiness depend on color alone.",
        "section": "colors"
      },
      {
        "name": "The Display Exception Rule",
        "body": "Preserve the approved oversized hero on this surface; use the bounded section-heading ramp for ordinary extensions.",
        "section": "typography"
      },
      {
        "name": "The Flat Field Rule",
        "body": "Preserve solid field separation and do not add floating shadows to the existing components.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain solid fields, square controls and the bundled Montserrat family.",
      "Do keep readable product names and readiness text separate from geometric artwork.",
      "Do retain visible focus and the reduced-motion behavior.",
      "Do use the existing mobile stacking and two-column index rather than shrinking desktop controls indefinitely."
    ],
    "donts": [
      "Don't turn the pinned hero sizing and compression into a default for every heading.",
      "Don't replace this flat geometric world with robots, neon gradients or volumetric illustrations.",
      "Don't reuse scenario text, synthetic data or readiness colors as proof of real results.",
      "Don't serve review evidence or mock images as application content."
    ]
  }
}
