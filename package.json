{
  "name": "leadgenbureau-concept",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "biome check .",
    "format": "biome format --write .",
    "test:ui": "node scripts/check-ui.mjs && node scripts/check-revenue.mjs && node scripts/check-journey.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
